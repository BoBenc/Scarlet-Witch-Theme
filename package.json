{
  "name": "scarlet-witch-theme",
  "displayName": "Scarlet Witch Theme",
  "description": "A fan-made VS Code theme inspired by Scarlet Witch.",
  "version": "0.0.8",
  "publisher": "BoBenc",
  "icon": "images/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/BoBenc/Scarlet-Witch-Theme.git"
  },
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Themes", "Visualization", "Other"
  ],
  "keywords": [
    "scarlet", "witch", "theme", "marvel", "avengers", "wanda", "maximoff", "red", "dark", "hungarian", "hun", "magyar"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "themes": [
      {
        "label": "Scarlet Witch (Dark)",
        "uiTheme": "vs-dark",
        "path": "themes/dark-color-theme.json"
      },
      {
        "label": "Scarlet Witch (Light)",
        "uiTheme": "vs",
        "path": "themes/light-color-theme.json"
      }
    ],
    "commands": [
      {
        "title": "ShowWelcome",
        "command": "scarlet-witch-theme.showWelcome",
        "category": "Scarlet Witch Theme"
      },
      {
        "title": "ShowReleaseNotes",
        "command": "scarlet-witch-theme.showReleaseNotes",
        "category": "Scarlet Witch Theme"
      },
      {
        "title": "ShowPictureGallery",
        "command": "scarlet-witch-theme.showPictureGallery",
        "category": "Scarlet Witch Theme"
      },
      {
        "title": "Fix all errors with Chaos Magic!",
        "command": "scarlet-witch-theme.copilotCommand",
        "category": "Scarlet Witch Theme"
      },
      {
        "title": "Darkhold",
        "command": "scarlet-witch-theme.openDarkhold",
        "category": "Scarlet Witch Theme"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "scarlet-witch-activitybar",
          "title": "Scarlet Witch Theme",
          "icon": "images/scarlet_witch_crown_icon.png"
        }
      ]
    },
    "views": {
      "scarlet-witch-activitybar": [
        {
          "type": "webview",
          "id": "scarlet-witch-sidebar",
          "name": "Home",
          "icon": "images/logo.png"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.107.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.48.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}